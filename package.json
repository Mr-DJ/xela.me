{
  "name": "tailwind-nextjs-starter-blog",
  "version": "1.1.4",
  "private": true,
  "scripts": {
    "start": "node ./scripts/next-remote-watch.mjs ./data",
    "dev": "next dev",
    "build": "next build && node ./scripts/generate-sitemap.mjs && node ./scripts/generate-rss.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "compose": "node ./scripts/compose.mjs",
    "generate-sitemap": "node ./scripts/generate-sitemap.mjs",
    "generate-rss": "node ./scripts/generate-rss.mjs"
  },
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.1.0",
    "katex": "^0.19.1",
    "mdx-bundler": "^10.1.1",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "smoothscroll-polyfill": "^0.4.4",
    "tailwindcss": "^4.3.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "^16.4.6",
    "chokidar": "^6.0.0",
    "commander": "^15.1.0",
    "cross-env": "^10.1.0",
    "dedent": "^1.7.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "inquirer": "^14.3.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "overrides": {
    "katex": "$katex",
    "postcss-selector-parser": "6.1.6",
    "toml": "5.0.1",
    "uuid": "11.1.1"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx|mjs)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|mjs|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
